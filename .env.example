# Environment Variables for Genius Consultancy CRM

# Database Connection (PostgreSQL / Neon)
# DATABASE_URL: Pooled connection string (with -pooler for Neon)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct unpooled connection string (without -pooler for migrations)
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="genius_consultancy_crm_super_secure_jwt_secret_key_2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Backup Storage
BACKUP_DIR="./backups"
