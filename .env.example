# Environment Variables for Genius Consultancy CRM

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genius_consultancy_crm?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genius_consultancy_crm?schema=public"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="genius_consultancy_crm_super_secure_jwt_secret_key_2026"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Backup Storage
BACKUP_DIR="./backups"
