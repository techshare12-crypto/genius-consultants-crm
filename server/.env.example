# ====================================================
# GENIUS CONSULTANTS OPERATIONS PORTAL - BACKEND ENV
# ====================================================

# Database Connection (PostgreSQL for Production, or SQLite for Local Dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genius_crm?schema=public"

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Allowed Frontend Origins (Comma-separated for multiple origins)
CLIENT_URL=https://genius-consultants-client.onrender.com
CORS_ORIGIN=https://genius-consultants-client.onrender.com
SOCKET_CORS_ORIGIN=https://genius-consultants-client.onrender.com

# ----------------------------------------------------
# Document & CV Storage Configuration (Optional)
# Options: LOCAL | S3 | CLOUDINARY
# ----------------------------------------------------
STORAGE_PROVIDER=LOCAL
LOCAL_UPLOAD_DIR=./uploads/documents

# AWS S3 / Cloudflare R2 / Supabase S3 (Optional)
S3_BUCKET=genius-crm-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
