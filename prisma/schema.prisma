// Genius Consultancy - Internal Recruitment Operations CRM
// Comprehensive Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITY, ACCESS CONTROL & ORGANIZATION
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PresenceStatus {
  ONLINE
  ACTIVE
  CALLING_ACTIVITY
  AFTER_CALL_WORK
  IDLE
  BREAK
  OFFLINE
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  fullName       String
  phone          String?
  status         UserStatus     @default(ACTIVE)
  presenceStatus PresenceStatus @default(OFFLINE)
  teamId         String?
  lastActivityAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  team           Team?          @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeams       Team[]         @relation("TeamLead")
  userRoles      UserRole[]

  // Operations relations
  assignedApplications       Application[]                  @relation("AssignedExecutive")
  delegatedAssignments       Application[]                  @relation("AssignedBy")
  finalShortlistedApps       Application[]                  @relation("FinalShortlistedBy")
  assignmentHistoriesAsExec  ApplicationAssignmentHistory[] @relation("ExecutiveHistory")
  assignmentHistoriesAsAdmin ApplicationAssignmentHistory[] @relation("AdminHistory")
  callLogs                   CallLog[]
  callbacks                  Callback[]
  screenings                 Screening[]
  clientSubmissions          ClientSubmission[]
  interviewsUpdated          Interview[]
  qualityReviewsReceived     QualityReview[]                @relation("ExecutiveQualityReviews")
  qualityReviewsGiven        QualityReview[]                @relation("ReviewerQualityReviews")

  // BD & Management relations
  createdCompanies           Company[]                      @relation("CompanyCreator")
  createdJobs                JobRequirement[]               @relation("JobCreator")
  companyFollowups           CompanyFollowup[]
  createdApplications        Application[]                  @relation("ApplicationCreator")
  uploadedImportBatches      ImportBatch[]
  auditLogs                  AuditLog[]
  notifications              Notification[]

  @@index([email])
  @@index([status])
  @@index([teamId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  module          String
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Team {
  id          String        @id @default(uuid())
  name        String        @unique
  teamLeadId  String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teamLead    User?         @relation("TeamLead", fields: [teamLeadId], references: [id])
  members     User[]        @relation("TeamMembers")
  applications Application[]
  assignmentHistories ApplicationAssignmentHistory[]

  @@map("teams")
}

// ==========================================
// 2. BUSINESS DEVELOPMENT & JOB MASTER
// ==========================================

enum CompanyStatus {
  PROSPECT
  CONTACTED
  DISCUSSION
  NEGOTIATION
  CONTRACT_PENDING
  ACTIVE
  INACTIVE
  CLOSED
}

model Company {
  id           String          @id @default(uuid())
  companyCode  String          @unique
  companyName  String
  industry     String?
  companyType  String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  website      String?
  status       CompanyStatus   @default(PROSPECT)
  source       String?
  notes        String?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  createdBy    User            @relation("CompanyCreator", fields: [createdById], references: [id])
  contacts     CompanyContact[]
  followups    CompanyFollowup[]
  jobRequirements JobRequirement[]
  applications Application[]
  submissions  ClientSubmission[]

  @@index([companyName])
  @@index([status])
  @@index([city])
  @@map("companies")
}

model CompanyContact {
  id          String   @id @default(uuid())
  companyId   String
  contactName String
  designation String?
  phone       String
  email       String?
  isPrimary   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([phone])
  @@map("company_contacts")
}

enum FollowupType {
  CALL
  MEETING
  EMAIL
  NOTE
}

model CompanyFollowup {
  id           String       @id @default(uuid())
  companyId    String
  userId       String
  followupType FollowupType @default(CALL)
  scheduledAt  DateTime?
  completedAt  DateTime?
  notes        String
  nextAction   String?
  createdAt    DateTime     @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([scheduledAt])
  @@map("company_followups")
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CLOSED
  CANCELLED
}

model JobRequirement {
  id                     String           @id @default(uuid())
  jobCode                String           @unique
  companyId              String
  jobTitle               String
  department             String?
  jobDescription         String?
  vacancies              Int              @default(1)
  location               String
  salaryMin              Decimal?         @db.Decimal(12, 2)
  salaryMax              Decimal?         @db.Decimal(12, 2)
  salaryText             String?
  experienceMin          Int              @default(0)
  experienceMax          Int?
  educationRequirement  String?
  genderRequirement     String?
  ageRequirement        String?
  skillsRequired         Json             @default("[]")
  twoWheelerRequired     Boolean          @default(false)
  drivingLicenseRequired Boolean          @default(false)
  noticePeriod           String?
  jobStatus              JobStatus        @default(OPEN)
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy              User             @relation("JobCreator", fields: [createdById], references: [id])
  applications           Application[]
  submissions            ClientSubmission[]

  @@index([companyId])
  @@index([jobStatus])
  @@index([location])
  @@map("job_requirements")
}

// ==========================================
// 3. CANDIDATE MASTER (PERMANENT PROFILE)
// ==========================================

model Candidate {
  id                 String           @id @default(uuid())
  candidateCode      String           @unique
  fullName           String
  rawPhone           String
  normalizedPhone    String           @unique
  alternatePhone     String?
  email              String?
  gender             String?
  age                Int?
  dateOfBirth        DateTime?
  currentLocation    String?
  permanentLocation  String?
  education          String?
  experienceYears    Int              @default(0)
  experienceMonths   Int              @default(0)
  currentCompany     String?
  currentJob         String?
  currentSalary      Decimal?         @db.Decimal(12, 2)
  expectedSalary     Decimal?         @db.Decimal(12, 2)
  noticePeriod       String?
  skills             Json             @default("[]")
  languages          Json             @default("[]")
  hasTwoWheeler      Boolean          @default(false)
  hasDrivingLicense  Boolean          @default(false)
  source             String           @default("EXCEL_IMPORT")
  sourceReference    String?
  notes              String?
  activeStatus       Boolean          @default(true)
  importBatchId      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  importBatch        ImportBatch?     @relation(fields: [importBatchId], references: [id])
  applications       Application[]
  assignmentHistories ApplicationAssignmentHistory[]
  callLogs           CallLog[]
  callbacks          Callback[]
  submissionItems    ClientSubmissionItem[]

  @@index([normalizedPhone])
  @@index([email])
  @@index([fullName])
  @@index([currentLocation])
  @@map("candidates")
}

// ==========================================
// 4. RECRUITMENT APPLICATION (TRANSACTION)
// ==========================================

enum ApplicationStage {
  NEW
  ASSIGNED
  CALLING
  INTERESTED
  SHORTLISTED
  FORM_PENDING
  FORM_RECEIVED
  CV_PENDING
  CV_RECEIVED
  SCREENING_PENDING
  SCREENING_IN_PROGRESS
  SCREENING_PASSED
  SCREENING_FAILED
  SCREENING_HOLD
  FINAL_SHORTLIST
  SENT_TO_CLIENT
  INTERVIEW_PENDING
  INTERVIEW_SCHEDULED
  INTERVIEW_IN_PROGRESS
  INTERVIEW_COMPLETED
  SELECTED
  REJECTED
  JOINING_PENDING
  JOINED
  NOT_JOINED
  CLOSED
}

enum FormStatus {
  PENDING
  SENT
  RECEIVED
}

enum CvStatus {
  CV_REQUIRED
  CV_REQUESTED
  CV_RECEIVED
  VERIFIED
}

model Application {
  id                   String           @id @default(uuid())
  applicationCode      String           @unique
  candidateId          String
  jobId                String
  companyId            String
  assignedExecutiveId  String?
  assignedTeamId       String?
  assignedById         String?
  assignedAt           DateTime?
  currentStage         ApplicationStage @default(NEW)
  formStatus           FormStatus       @default(PENDING)
  cvStatus             CvStatus         @default(CV_REQUIRED)
  formSentAt           DateTime?
  formReceivedAt       DateTime?
  cvRequestedAt        DateTime?
  cvReceivedAt         DateTime?
  readyForScreeningAt  DateTime?
  finalShortlistedAt   DateTime?
  finalShortlistedById String?
  notes                String?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  candidate            Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                  JobRequirement   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedExecutive    User?            @relation("AssignedExecutive", fields: [assignedExecutiveId], references: [id])
  assignedTeam         Team?            @relation(fields: [assignedTeamId], references: [id])
  assignedBy           User?            @relation("AssignedBy", fields: [assignedById], references: [id])
  finalShortlistedBy   User?            @relation("FinalShortlistedBy", fields: [finalShortlistedById], references: [id])
  createdBy            User             @relation("ApplicationCreator", fields: [createdById], references: [id])

  assignmentHistories  ApplicationAssignmentHistory[]
  callLogs             CallLog[]
  callbacks            Callback[]
  screenings           Screening[]
  submissionItems      ClientSubmissionItem[]
  interviews           Interview[]
  qualityReviews       QualityReview[]

  @@index([candidateId])
  @@index([jobId])
  @@index([companyId])
  @@index([assignedExecutiveId, currentStage])
  @@index([currentStage])
  @@map("applications")
}

model ApplicationAssignmentHistory {
  id             String      @id @default(uuid())
  applicationId  String
  candidateId    String
  executiveId    String
  teamId         String?
  assignedById   String
  assignedAt     DateTime    @default(now())
  unassignedAt   DateTime?
  reason         String?
  assignmentMode String      @default("MANUAL")

  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  executive      User        @relation("ExecutiveHistory", fields: [executiveId], references: [id])
  team           Team?       @relation(fields: [teamId], references: [id])
  assignedBy     User        @relation("AdminHistory", fields: [assignedById], references: [id])

  @@index([applicationId])
  @@index([candidateId])
  @@index([executiveId])
  @@index([assignedAt])
  @@map("application_assignment_histories")
}

// ==========================================
// 5. CALLING & CALLBACK OPERATIONAL ENGINE
// ==========================================

enum CallOutcome {
  CONNECTED
  RNR
  CALLBACK
  NOT_INTERESTED
  INTERESTED
  NOT_ELIGIBLE
  WRONG_NUMBER
  SWITCHED_OFF
  BUSY
  SHORTLISTED
}

model CallLog {
  id               String      @id @default(uuid())
  applicationId    String
  candidateId      String
  executiveId      String
  callOutcome      CallOutcome
  remarks          String?
  callbackRequired Boolean     @default(false)
  callbackDateTime DateTime?
  createdAt        DateTime    @default(now())

  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate        Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  executive        User        @relation(fields: [executiveId], references: [id])
  callbacks        Callback[]

  @@index([applicationId, executiveId, createdAt])
  @@index([candidateId])
  @@index([callOutcome])
  @@index([createdAt])
  @@map("call_logs")
}

enum CallbackPriority {
  HIGH
  MEDIUM
  LOW
}

enum CallbackStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Callback {
  id                String           @id @default(uuid())
  applicationId     String
  candidateId       String
  executiveId       String
  sourceCallLogId   String?
  scheduledAt       DateTime
  reason            String
  priority          CallbackPriority @default(MEDIUM)
  status            CallbackStatus   @default(PENDING)
  completedAt       DateTime?
  completionRemarks String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  application       Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate         Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  executive         User             @relation(fields: [executiveId], references: [id])
  sourceCallLog     CallLog?         @relation(fields: [sourceCallLogId], references: [id])

  @@index([executiveId, status, scheduledAt])
  @@index([applicationId])
  @@index([candidateId])
  @@index([scheduledAt])
  @@map("callbacks")
}

// ==========================================
// 6. SCREENING, SHORTLIST & SUBMISSION
// ==========================================

enum ScreeningStatus {
  PASS
  FAIL
  HOLD
}

model Screening {
  id                String          @id @default(uuid())
  applicationId     String
  screenerId        String
  screeningStatus   ScreeningStatus
  screeningDate     DateTime        @default(now())
  holdFollowupDate  DateTime?
  remarks           String?
  nextAction        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  application       Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  screener          User            @relation(fields: [screenerId], references: [id])

  @@index([applicationId])
  @@index([screenerId])
  @@index([screeningStatus])
  @@map("screenings")
}

enum SubmissionMethod {
  EMAIL
  WHATSAPP_MANUAL
  PORTAL
}

model ClientSubmission {
  id               String                 @id @default(uuid())
  submissionCode   String                 @unique
  companyId        String
  jobId            String
  submittedById    String
  submittedAt      DateTime               @default(now())
  submissionMethod SubmissionMethod       @default(EMAIL)
  remarks          String?
  createdAt        DateTime               @default(now())

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job              JobRequirement         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submittedBy      User                   @relation(fields: [submittedById], references: [id])
  items            ClientSubmissionItem[]
  interviews       Interview[]

  @@index([companyId])
  @@index([jobId])
  @@index([submittedAt])
  @@map("client_submissions")
}

model ClientSubmissionItem {
  id             String           @id @default(uuid())
  submissionId   String
  applicationId  String
  candidateId    String
  clientFeedback String?
  feedbackDate   DateTime?
  createdAt      DateTime         @default(now())

  submission     ClientSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([submissionId, applicationId])
  @@index([candidateId])
  @@map("client_submission_items")
}

// ==========================================
// 7. MULTI-ROUND INTERVIEW ENGINE
// ==========================================

enum InterviewMode {
  OFFLINE
  VIRTUAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  NO_SHOW
  CANCELLED
}

enum InterviewOutcome {
  PENDING
  SELECTED_FOR_NEXT_ROUND
  SELECTED
  REJECTED
  HOLD
}

model Interview {
  id             String           @id @default(uuid())
  applicationId  String
  submissionId   String?
  roundNumber    Int              @default(1)
  roundName      String           @default("Round 1")
  scheduledAt    DateTime
  mode           InterviewMode    @default(OFFLINE)
  location       String?
  status         InterviewStatus  @default(SCHEDULED)
  outcome        InterviewOutcome @default(PENDING)
  feedback       String?
  updatedById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  submission     ClientSubmission? @relation(fields: [submissionId], references: [id])
  updatedBy      User             @relation(fields: [updatedById], references: [id])

  @@index([applicationId, roundNumber])
  @@index([status])
  @@index([scheduledAt])
  @@map("interviews")
}

// ==========================================
// 8. QUALITY REVIEWS, AUDIT & NOTIFICATIONS
// ==========================================

model QualityReview {
  id                    String      @id @default(uuid())
  applicationId         String
  executiveId           String
  reviewerId            String
  rating                Int         @default(3)
  communicationScore    Int         @default(3)
  jobExplanationScore   Int         @default(3)
  processAdherenceScore Int         @default(3)
  remarks               String
  reviewedAt            DateTime    @default(now())

  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  executive             User        @relation("ExecutiveQualityReviews", fields: [executiveId], references: [id])
  reviewer              User        @relation("ReviewerQualityReviews", fields: [reviewerId], references: [id])

  @@index([applicationId])
  @@index([executiveId])
  @@index([reviewedAt])
  @@map("quality_reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ImportStatus {
  PENDING
  PREVIEW
  COMMITTED
  FAILED
}

model ImportBatch {
  id            String       @id @default(uuid())
  batchCode     String       @unique
  filename      String
  uploadedById  String
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  skippedRows   Int          @default(0)
  duplicateRows Int          @default(0)
  failedRows    Int          @default(0)
  mappingConfig Json         @default("{}")
  status        ImportStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  candidates    Candidate[]

  @@index([uploadedById])
  @@index([createdAt])
  @@map("import_batches")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  title      String
  message    String
  type       String    @default("SYSTEM")
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
